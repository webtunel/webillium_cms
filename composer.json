{
    "name": "webtunel/webilliumcms",
    "description": "Webillium CMS Is CRUD Generator Based On Laravel Easy To Make An Advanced Backend",
    "type": "library",
    "license": "MIT",
    "keywords":[
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "wevillium-cms",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Milos",
            "email": "milos.cvijic@ollitweb.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.3|^8.0|^8.2",
        "barryvdh/laravel-dompdf": "^2.0",
        "doctrine/dbal": "^3.0",
        "maatwebsite/excel": "^3.1",
        "intervention/imagecache": "^2.6",
        "intervention/image": "^2.7.2",
        "laravel/framework": "^10.0",
        "krlove/code-generator": "^1.0",
        "opis/closure": "^3.6.3"
    },
    "autoload": {
        "psr-4": {
          "webtunel\\webilliumcms\\": "src/"
        }
      },
    "autoload-dev": {
        "psr-4": {
            "Krlove\\Tests\\Integration\\": "tests/integration"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "webtunel\\webilliumcms\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php artisan vendor:publish --provider=\"webtunel\\webilliumcms\\CRUDBoosterServiceProvider\" --tag=cb_asset --force"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --provider=\"webtunel\\webilliumcms\\CRUDBoosterServiceProvider\" --tag=cb_asset --force"
        ]
    }
}
